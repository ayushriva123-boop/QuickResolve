{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user account and assigned RBAC role in QuickResolve.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 150
        },
        "role": {
          "type": "string",
          "enum": ["MAIN_ADMIN", "ADMIN", "STUDENT"]
        },
        "authProvider": {
          "type": "string",
          "enum": ["GOOGLE"]
        },
        "studentId": {
          "type": "string",
          "maxLength": 50
        },
        "department": {
          "type": "string",
          "maxLength": 100
        },
        "inviteId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "name",
        "email",
        "role",
        "authProvider",
        "studentId",
        "department",
        "createdAt",
        "updatedAt"
      ]
    },
    "RoleInvite": {
      "title": "RoleInvite",
      "description": "Main Admin pre-created user ID and role assignment (ADMIN or STUDENT) mapped by verified Google email.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 150
        },
        "role": {
          "type": "string",
          "enum": ["ADMIN", "STUDENT"]
        },
        "studentId": {
          "type": "string",
          "maxLength": 50
        },
        "department": {
          "type": "string",
          "maxLength": 100
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "role",
        "studentId",
        "department",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Complaint": {
      "title": "Complaint",
      "description": "Student campus complaint record with mandatory proof image and administrative resolution status.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "refCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "studentEmail": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 150
        },
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 150
        },
        "category": {
          "type": "string",
          "enum": [
            "Hostel & Accommodation",
            "IT & Network",
            "Academics & Faculty",
            "Library & Labs",
            "Canteen & Hygiene",
            "Infrastructure & Maintenance",
            "Transport",
            "Administration",
            "Other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 15,
          "maxLength": 2000
        },
        "proofImage": {
          "type": "string",
          "minLength": 10,
          "maxLength": 650000
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "In Progress", "Resolved"]
        },
        "adminRemarks": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "refCode",
        "userId",
        "studentName",
        "studentEmail",
        "title",
        "category",
        "description",
        "proofImage",
        "status",
        "adminRemarks",
        "createdAt",
        "updatedAt"
      ]
    },
    "EmailNotification": {
      "title": "EmailNotification",
      "description": "Audit record of an email notification triggered via Gmail when a complaint status changes to In Progress or Resolved.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "complaintId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "refCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 20
        },
        "studentUserId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recipientEmail": {
          "type": "string",
          "format": "email",
          "minLength": 5,
          "maxLength": 150
        },
        "studentName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "complaintTitle": {
          "type": "string",
          "minLength": 5,
          "maxLength": 150
        },
        "triggeredStatus": {
          "type": "string",
          "enum": ["In Progress", "Resolved"]
        },
        "subject": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200
        },
        "bodyPreview": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        },
        "deliveryStatus": {
          "type": "string",
          "enum": ["SENT", "FAILED", "PENDING_AUTH"]
        },
        "gmailMessageId": {
          "type": "string",
          "maxLength": 128
        },
        "errorMessage": {
          "type": "string",
          "maxLength": 500
        },
        "triggeredByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "complaintId",
        "refCode",
        "studentUserId",
        "recipientEmail",
        "studentName",
        "complaintTitle",
        "triggeredStatus",
        "subject",
        "bodyPreview",
        "deliveryStatus",
        "gmailMessageId",
        "errorMessage",
        "triggeredByUid",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User profiles and authoritative RBAC roles keyed by Firebase Auth UID."
    },
    "/roleInvites/{inviteId}": {
      "schema": {
        "$ref": "#/entities/RoleInvite"
      },
      "description": "Main Admin pre-created user IDs and assigned roles prior to first Google Sign-In."
    },
    "/complaints/{complaintId}": {
      "schema": {
        "$ref": "#/entities/Complaint"
      },
      "description": "Campus complaints with mandatory proof images and status workflow."
    },
    "/emailNotifications/{notificationId}": {
      "schema": {
        "$ref": "#/entities/EmailNotification"
      },
      "description": "Email notification dispatch records when complaint status becomes In Progress or Resolved."
    }
  }
}
